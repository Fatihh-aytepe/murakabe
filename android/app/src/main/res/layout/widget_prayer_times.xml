<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_signature"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Üst satır: hicri tarih + sonraki vakit rozeti -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_hijri"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12.5sp"
            android:textColor="#D4AF37"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="-- -- ----" />

        <TextView
            android:id="@+id/tv_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:text="" />
    </LinearLayout>

    <!-- 6 vakit kartı — sıradaki vakit renkli, yuvarlak köşeli bir zeminle
         (widget_chip_bg, vurgu rengine boyanmış) öne çıkar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="6">

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="2dp">
            <ImageView android:id="@+id/card_bg_0" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_chip_bg" android:visibility="invisible" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp">
                <TextView android:id="@+id/tv_name_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#B9C2CC" android:maxLines="1" android:text="İmsak" />
                <TextView android:id="@+id/tv_time_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#FFFFFF" android:textStyle="bold" android:paddingTop="3dp" android:text="--:--" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <ImageView android:id="@+id/card_bg_1" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_chip_bg" android:visibility="invisible" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp">
                <TextView android:id="@+id/tv_name_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#B9C2CC" android:maxLines="1" android:text="Güneş" />
                <TextView android:id="@+id/tv_time_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#FFFFFF" android:textStyle="bold" android:paddingTop="3dp" android:text="--:--" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <ImageView android:id="@+id/card_bg_2" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_chip_bg" android:visibility="invisible" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp">
                <TextView android:id="@+id/tv_name_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#B9C2CC" android:maxLines="1" android:text="Öğle" />
                <TextView android:id="@+id/tv_time_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#FFFFFF" android:textStyle="bold" android:paddingTop="3dp" android:text="--:--" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <ImageView android:id="@+id/card_bg_3" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_chip_bg" android:visibility="invisible" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp">
                <TextView android:id="@+id/tv_name_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#B9C2CC" android:maxLines="1" android:text="İkindi" />
                <TextView android:id="@+id/tv_time_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#FFFFFF" android:textStyle="bold" android:paddingTop="3dp" android:text="--:--" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <ImageView android:id="@+id/card_bg_4" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_chip_bg" android:visibility="invisible" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp">
                <TextView android:id="@+id/tv_name_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#B9C2CC" android:maxLines="1" android:text="Akşam" />
                <TextView android:id="@+id/tv_time_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#FFFFFF" android:textStyle="bold" android:paddingTop="3dp" android:text="--:--" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp">
            <ImageView android:id="@+id/card_bg_5" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_chip_bg" android:visibility="invisible" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp">
                <TextView android:id="@+id/tv_name_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#B9C2CC" android:maxLines="1" android:text="Yatsı" />
                <TextView android:id="@+id/tv_time_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#FFFFFF" android:textStyle="bold" android:paddingTop="3dp" android:text="--:--" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</LinearLayout>
