 .../reminders/reminders_screen.dart           | 59 ++++++++++++++++++-
 1 file changed, 56 insertions(+), 3 deletions(-)

diff --git a/lib/presentation/reminders/reminders_screen.dart b/lib/presentation/reminders/reminders_screen.dart
index 7acc6d2..0a2172a 100644
--- a/lib/presentation/reminders/reminders_screen.dart
+++ b/lib/presentation/reminders/reminders_screen.dart
@@ -400,11 +400,30 @@ class _RemindersScreenState extends State<RemindersScreen> {
                               _uid!, reminder.toMap());
                         } catch (_) {}
                       }
-                      // Bildirim planla
-                      await _scheduleReminderNotification(reminder);
+                      // DÜZELTME: Bildirim planlama (Android 12+ "tam
+                      // zamanlı alarm" izni verilmemişse) bir istisna
+                      // fırlatabiliyordu — bu istisna try/catch olmadan
+                      // buradan yukarı fırlayınca ne Navigator.pop ne de
+                      // _loadReminders() hiç ÇALIŞMIYORDU: hatırlatıcı
+                      // SQLite'a yazılmış olsa da ekran anlık güncellenmiyor
+                      // (sadece uygulama kapatılıp açılınca initState'teki
+                      // _loadReminders ile görünüyordu) ve bildirim de hiç
+                      // planlanamadığı için asla gelmiyordu. Artık kayıt/
+                      // ekran güncelleme her durumda tamamlanıyor; sadece
+                      // planlama başarısızsa kullanıcıyı izin eksikliği
+                      // konusunda uyarıyoruz.
+                      String? schedulingError;
+                      try {
+                        await _scheduleReminderNotification(reminder);
+                      } catch (e) {
+                        schedulingError = e.toString();
+                      }
                       if (!ctx.mounted) return;
                       Navigator.pop(ctx);
                       await _loadReminders();
+                      if (schedulingError != null) {
+                        await _warnIfExactAlarmPermissionMissing();
+                      }
                     },
                     child: const Text('Hatırlatıcı Kur'),
                   ),
@@ -439,7 +458,16 @@ class _RemindersScreenState extends State<RemindersScreen> {
     // planlanmış bildirim iptal EDİLMİYORDU, kullanıcı sildiği bir
     // hatırlatıcı için yine de bildirim alabiliyordu. Aynı formülle
     // hesaplanan ID ile bildirimi de iptal ediyoruz.
-    await NotificationService().cancelNotification(_notifIdFor(reminder.id));
+    //
+    // DÜZELTME 2: bildirim iptali try/catch İÇİNDE olmadığı için (nadiren
+    // de olsa) burada fırlayan bir istisna, aşağıdaki SQLite silmesinin ve
+    // ekranın yenilenmesinin HİÇ çalışmamasına yol açabiliyordu — "sil
+    // deyince silinmiyor" şikâyetinin olası bir sebebi. Asıl silme işlemi
+    // artık bildirim iptali başarısız olsa bile her zaman tamamlanıyor.
+    try {
+      await NotificationService()
+          .cancelNotification(_notifIdFor(reminder.id));
+    } catch (_) {}
     await _db.delete('reminders', where: 'id = ?', whereArgs: [reminder.id]);
     if (_uid != null) {
       try {
@@ -449,6 +477,31 @@ class _RemindersScreenState extends State<RemindersScreen> {
     await _loadReminders();
   }
 
+  /// Bildirim planlama bir istisna fırlattıysa, çoğunlukla sebep Android
+  /// 12+ "tam zamanlı alarm" (exact alarm) izninin verilmemiş olmasıdır —
+  /// bu durumda hatırlatıcı kaydedilir ama bildirim HİÇ tetiklenmez.
+  /// Kullanıcıyı bilgilendirip izni doğrudan buradan istemesini sağlıyoruz.
+  Future<void> _warnIfExactAlarmPermissionMissing() async {
+    final canSchedule =
+        await NotificationService().checkExactAlarmPermission();
+    if (canSchedule || !mounted) return;
+    ScaffoldMessenger.of(context).showSnackBar(
+      SnackBar(
+        content: const Text(
+          'Hatırlatıcı kaydedildi ama bildirim izni eksik olduğu için '
+          'zamanında gelmeyebilir.',
+        ),
+        action: SnackBarAction(
+          label: 'İzin Ver',
+          onPressed: () async {
+            await NotificationService().requestExactAlarmPermission();
+          },
+        ),
+        duration: const Duration(seconds: 6),
+      ),
+    );
+  }
+
