rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Her kullanıcı sadece kendi notes/{uid}/... klasörüne erişebilir.
    match /notes/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tanımlı olmayan her yol varsayılan olarak kapalı.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
